# Brickken sandbox
BRICKKEN_API_KEY=
BRICKKEN_BASE_URL=https://api.sandbox.brickken.com

# Wallet used as signerAddress — must be whitelisted by Brickken first.
# Testnet only. Never commit the real .env file.
SIGNER_ADDRESS=
PRIVATE_KEY=

# Target network for the Agentic challenge
CHAIN_ID=aa36a7
CHAIN_ID_DECIMAL=11155111

# x402 payer wallet (can be the same as SIGNER_ADDRESS)
X402_PRIVATE_KEY=

# REST API
PORT=4000
MOCK_MODE=true
